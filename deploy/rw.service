[Unit]
Description=RW setup server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rw
Group=rw
WorkingDirectory=/opt/rw
EnvironmentFile=/etc/rw/rw.env
ExecStart=/usr/bin/node /opt/rw/apps/server/dist/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
