# Copy to /etc/caddy/Caddyfile and replace rw.example.com with the real domain.
# Access logging stays disabled: request URLs may contain pairing identifiers.
rw.example.com {
    root * /opt/rw/apps/web/dist
    encode zstd gzip

    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(self), microphone=(self)"
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:3000
    }

    # Caddy's reverse_proxy supports the Socket.IO WebSocket upgrade.
    handle /socket.io/* {
        reverse_proxy 127.0.0.1:3000
    }

    # Vite's history fallback keeps /camera and /viewer client routes working.
    handle {
        try_files {path} /index.html
        file_server
    }
}
