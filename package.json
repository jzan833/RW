{
  "name": "rw",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "check:deploy": "node apps/server/scripts/check-deployment.mjs",
    "dev": "concurrently --kill-others-on-fail --names server,web --prefix name \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @rw/web",
    "dev:server": "npm run dev -w @rw/server",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11"
  }
}
